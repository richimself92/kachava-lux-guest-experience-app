rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero direct client-to-database access.
    // All Guest Portal (web/) and Admin Dashboard (admin/) reads and writes
    // are brokered through the shared NestJS Cloud Run backend via IAM Service Account.
    match /{document=**} {
      allow read, write: if false;
    }

    // Real-time change signals (ADR-012): `{at, topic, seq}` only, no business
    // data. Clients may read one signal doc by its unguessable id; the backend
    // (Admin SDK) is the only writer.
    match /realtime_signals/{id} {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
