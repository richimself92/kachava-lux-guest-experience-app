# Kachava Lux backend environment template. Copy to `.env` locally; never commit real values.
# In NODE_ENV=production, or whenever USE_FIRESTORE=true / USE_GCP_FIRESTORE=true, each secret below
# is REQUIRED and must be at least 32 characters, otherwise startup fails.
# Locally (in-memory mode) they may be left empty: a random per-process secret is generated.
# Generate a value with: openssl rand -base64 48

NODE_ENV=development
PORT=3001

# false = in-memory adapters (default for local work); true = Firestore + Cloud Storage + Firebase Auth.
USE_FIRESTORE=false

# HMAC key for staff session tokens issued by POST /api/v1/admin/auth/login.
STAFF_JWT_SECRET=
# HMAC key for guest step-up tokens issued by POST /api/v1/stays/:guestUuid/verify-step-up.
STEPUP_HMAC_SECRET=
# HMAC key for local-development storage URLs (in-memory mode only).
STORAGE_SIGNING_SECRET=

# Optional overrides.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=
CORS_ALLOWED_ORIGINS=
