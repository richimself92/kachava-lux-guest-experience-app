# Kachava Lux backend environment template. Copy to `.env` locally; never commit real values.
# The backend ALWAYS persists to Firestore + Cloud Storage (there is no in-memory mode and no seed
# data: the database starts empty and everything is created from the admin).
# Outside NODE_ENV=production it refuses to start unless both emulator hosts are set, so a machine
# with Google credentials can never touch the live database or bucket. ./run-local.sh sets all of this.

NODE_ENV=development
PORT=3011

# Required acknowledgement: the backend persists to Firestore.
USE_FIRESTORE=true

# Local emulators (required outside production).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_PROJECT_ID=demo-kachava
# Locally "(default)": the emulator only exports/imports the default database.
FIRESTORE_DATABASE_ID="(default)"
FIREBASE_STORAGE_BUCKET=demo-kachava.appspot.com

# Technical identity of the admin console (silent login, HOST_ADMIN). Required in production.
ADMIN_SERVICE_EMAIL=

# HMAC keys, at least 32 characters each (generate with: openssl rand -hex 32).
# STAFF_JWT_SECRET signs staff sessions from POST /api/v1/admin/auth/login.
STAFF_JWT_SECRET=
# STEPUP_HMAC_SECRET signs guest step-up tokens from POST /api/v1/stays/:guestUuid/verify-step-up.
STEPUP_HMAC_SECRET=

# Optional.
GUEST_PORTAL_URL=
CORS_ALLOWED_ORIGINS=
